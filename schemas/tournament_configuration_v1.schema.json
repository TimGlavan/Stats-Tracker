{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stats-tracker.local/schemas/tournament_configuration_v1.schema.json",
  "title": "Basketball tournament configuration, version 1",
  "description": "Roster and identity configuration shared by scorer and tournament-management applications.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tournament_id",
    "name",
    "configuration_version",
    "teams"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "tournament_id": {
      "$ref": "#/$defs/identifier"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "configuration_version": {
      "type": "integer",
      "minimum": 1
    },
    "teams": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/team"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "team": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "team_id",
        "name",
        "abbreviation",
        "players"
      ],
      "properties": {
        "team_id": {
          "$ref": "#/$defs/identifier"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "abbreviation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8
        },
        "primary_color": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "secondary_color": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "players": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/player"
          }
        }
      }
    },
    "player": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "player_id",
        "name",
        "jersey_number"
      ],
      "properties": {
        "player_id": {
          "$ref": "#/$defs/identifier"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "jersey_number": {
          "type": "string",
          "minLength": 1,
          "maxLength": 3
        }
      }
    }
  }
}
